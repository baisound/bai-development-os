{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.2.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["permit_version","permit_id","issuer_identity","project_id","task_id","role","session_id","selected_input_set_checksum","trusted_root_set_checksum","guard_config_checksum","decision","guard_decision","preflight_result_id","preflight_result_checksum","estimated_output_tokens","estimated_artifact_bytes","expected_artifact_sections","issued_at","expires_at","single_use","content_checksum"],
  "properties": {
    "permit_version": {"const":"1.2.0"},
    "permit_id":{"type":"string","minLength":1},
    "issuer_identity":{"type":"string","minLength":1},
    "project_id":{"type":"string","minLength":1},
    "task_id":{"type":"string","pattern":"^TASK-[0-9]{3,}$"},
    "role":{"type":"string","minLength":1},
    "session_id":{"type":"string","minLength":1},
    "selected_input_set_checksum":{"type":"string","pattern":"^sha256:"},
    "trusted_root_set_checksum":{"type":"string","pattern":"^sha256:"},
    "guard_config_checksum":{"type":"string","pattern":"^sha256:"},
    "decision":{"enum":["PASS","PASS_WITH_REDUCTION"]},
    "guard_decision":{"enum":["PASS","PASS_WITH_REDUCTION"]},
    "preflight_result_id":{"type":"string","minLength":1},
    "preflight_result_checksum":{"type":"string","pattern":"^sha256:"},
    "estimated_output_tokens":{"type":"integer","minimum":0},
    "estimated_artifact_bytes":{"type":"integer","minimum":0},
    "expected_artifact_sections":{"type":"integer","minimum":0},
    "issued_at":{"type":"string"},
    "expires_at":{"type":"string"},
    "single_use":{"const":true},
    "activation_binding": {
      "type":"object",
      "required":["binding_version","activation_entry_id","entry_owner","requester_identity","phase","scope","correlation_id","registry_revision","registry_checksum","state_revision","state_checksum"],
      "additionalProperties":false
    },
    "content_checksum":{"type":"string","pattern":"^sha256:"}
  },
  "not":{"required":["consumed_at"]}
}
