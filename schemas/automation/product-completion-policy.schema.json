{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.dev/schemas/automation/product-completion-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product_id", "revision", "required_gates", "judge_required", "lifecycle_required", "closure_required"],
  "properties": {
    "schema": { "const": "BAI_PRODUCT_COMPLETION_POLICY_V1" },
    "product_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "required_gates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "judge_required": { "const": true },
    "lifecycle_required": { "const": "COMPLETED" },
    "closure_required": { "const": "CLOSED" }
  }
}
