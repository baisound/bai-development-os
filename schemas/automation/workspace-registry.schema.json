{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://baisound.dev/schemas/automation/workspace-registry.schema.json",
  "title":"BAI Workspace Registry Snapshot",
  "type":"object",
  "additionalProperties":false,
  "required":["registry_schema_version","registry_id","root_identity","entries","generated_at","content_authority","content_checksum"],
  "properties":{
    "registry_schema_version":{"const":"1.0.0"},
    "registry_id":{"type":"string","minLength":1},
    "root_identity":{"type":"string","minLength":1},
    "entries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["entry_id","category","path","sha256","size_bytes","mtime_ms","authority","status"],"properties":{"entry_id":{"type":"string","minLength":1},"category":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"size_bytes":{"type":"integer","minimum":0},"mtime_ms":{"type":"integer","minimum":0},"authority":{"type":"string","minLength":1},"status":{"const":"CURRENT"}}}},
    "generated_at":{"type":"string","format":"date-time"},
    "content_authority":{"const":false},
    "content_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
  }
}
