{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.dev/schemas/automation/autonomous-worklane.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lane_id", "task_id", "subject_id", "authority_grant_id", "authority_epoch", "state", "resource_ownership", "allowed_capabilities", "denied_capabilities", "fallback_lane_ids", "transition_sequence", "previous_transition_checksum", "updated_at", "content_checksum"],
  "properties": {
    "schema": { "const": "BAI_AUTONOMOUS_WORKLANE_V1" },
    "lane_id": { "$ref": "#/$defs/nonempty" },
    "task_id": { "$ref": "#/$defs/nonempty" },
    "subject_id": { "$ref": "#/$defs/nonempty" },
    "authority_grant_id": { "$ref": "#/$defs/nonempty" },
    "authority_epoch": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["PLANNED", "RUNNABLE", "ACTIVE", "GATE_PARKED", "STALLED", "RECOVERY_REQUIRED", "HANDOFF_PENDING", "COMPLETED", "REVOKED"] },
    "resource_ownership": { "$ref": "#/$defs/uniqueStrings" },
    "allowed_capabilities": { "$ref": "#/$defs/uniqueStrings" },
    "denied_capabilities": { "$ref": "#/$defs/uniqueStrings" },
    "fallback_lane_ids": { "$ref": "#/$defs/uniqueStrings" },
    "transition_sequence": { "type": "integer", "minimum": 0 },
    "previous_transition_checksum": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/checksum" }] },
    "updated_at": { "type": "string", "format": "date-time" },
    "content_checksum": { "$ref": "#/$defs/checksum" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "uniqueStrings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
