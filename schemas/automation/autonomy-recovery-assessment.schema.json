{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.dev/schemas/automation/autonomy-recovery-assessment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["recovery_assessment_version", "result", "safe_to_resume", "automatic_mutation_allowed", "reasons", "required_actions", "content_checksum"],
  "properties": {
    "recovery_assessment_version": { "const": "1.0.0" },
    "result": { "enum": ["RECOVERY_RESUME_READY", "RECOVERY_GATE_REQUIRED", "TEST_FAILURE_REPAIR", "PROVIDER_UNAVAILABLE_SUSPENDED", "USAGE_LIMIT_SUSPENDED", "MISSED_SCHEDULE_REPLAN"] },
    "safe_to_resume": { "type": "boolean" },
    "automatic_mutation_allowed": { "const": false },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "content_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
