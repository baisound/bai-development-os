{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.dev/schemas/automation/autonomy-failure-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "effective_date", "canonical_scope", "domains"],
  "properties": {
    "registry_version": { "const": "1.0.0" },
    "effective_date": { "type": "string", "format": "date" },
    "canonical_scope": { "const": "TASK-018_CONSUMER_INDEPENDENT_CORE" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "default_operator_action", "signals", "codes"],
        "properties": {
          "domain": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "default_operator_action": { "type": "string", "minLength": 1 },
          "signals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          },
          "codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          }
        }
      }
    }
  }
}
