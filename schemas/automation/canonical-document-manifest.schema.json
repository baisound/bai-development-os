{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://baisound.dev/schemas/automation/canonical-document-manifest.schema.json","title":"BAI Canonical Document Manifest",
  "type":"object","additionalProperties":false,"required":["document_manifest_version","manifest_id","documents","content_authority","content_checksum"],
