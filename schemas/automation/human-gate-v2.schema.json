{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.dev/schemas/automation/human-gate-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gate_id", "lane_id", "blocked_resource_scope", "blocked_capabilities", "safe_fallback_lane_ids", "system_wide_block", "status", "reason_code", "authority_epoch", "created_at", "content_checksum"],
  "properties": {
    "schema": { "const": "BAI_HUMAN_GATE_V2" },
    "gate_id": { "$ref": "#/$defs/nonempty" },
    "lane_id": { "$ref": "#/$defs/nonempty" },
    "blocked_resource_scope": { "$ref": "#/$defs/uniqueStrings" },
    "blocked_capabilities": { "$ref": "#/$defs/uniqueStrings" },
    "safe_fallback_lane_ids": { "$ref": "#/$defs/uniqueStrings" },
    "system_wide_block": { "type": "boolean" },
    "status": { "enum": ["WAITING_OWNER", "SATISFIED", "CANCELLED", "EXPIRED"] },
    "reason_code": { "$ref": "#/$defs/nonempty" },
    "authority_epoch": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "content_checksum": { "$ref": "#/$defs/checksum" }
  },
  "allOf": [{
    "if": { "properties": { "system_wide_block": { "const": true } }, "required": ["system_wide_block"] },
    "then": { "properties": { "safe_fallback_lane_ids": { "maxItems": 0 } } }
  }],
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "uniqueStrings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
