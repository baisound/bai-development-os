{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bai://schemas/calibration/policy-candidate",
  "type": "object",
  "required": [
    "policy_candidate_version",
    "candidate_id",
    "base_policy_version",
    "adjustments",
    "safety",
    "safety_decision",
    "evaluation_requirements",
    "authority_effect",
    "content_checksum"
  ],
  "properties": {
    "policy_candidate_version": {
      "const": "1.0.0"
    },
    "safety_decision": {
      "enum": [
        "ALLOW",
        "BLOCK"
      ]
    },
    "evaluation_requirements": {
      "type": "array",
      "items": {
        "enum": [
          "COUNTERFACTUAL",
          "SHADOW"
        ]
      }
    },
    "adjustments": {
      "type": "array",
      "minItems": 1
    },
    "content_checksum": {
      "type": "string",
      "pattern": "^sha256:"
    }
  },
  "additionalProperties": true
}
