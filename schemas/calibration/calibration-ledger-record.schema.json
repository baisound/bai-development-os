{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bai://schemas/calibration/calibration-ledger-record",
  "type": "object",
  "required": [
    "seq",
    "type",
    "payload",
    "previous_record_checksum",
    "record_checksum"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "EVIDENCE",
        "POLICY_CANDIDATE",
        "POLICY_EVALUATION",
        "POLICY_ACTIVATED"
      ]
    },
    "previous_record_checksum": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_checksum": {
      "type": "string",
      "pattern": "^sha256:"
    }
  },
  "additionalProperties": true
}
