{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/improvement-candidate-routing-record.schema.json", "title": "Improvement Candidate Routing Record", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "candidate_id", "observation", "reproducibility", "recurrence", "scope", "severity", "critic_disposition", "recommendation", "knowledge_promotion_authority", "task_allocation_authority", "content_checksum"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_type": {"const": "improvement-candidate-routing-record"}, "intake_id": {"$ref": "#/$defs/id"}, "candidate_id": {"$ref": "#/$defs/id"}, "observation": {"type": "string", "minLength": 1, "maxLength": 4096}, "reproducibility": {"enum": ["REPRODUCED", "NOT_REPRODUCED", "UNKNOWN"]}, "recurrence": {"type": "integer", "minimum": 0}, "scope": {"enum": ["LOCAL", "PROJECT", "CROSS_PROJECT"]}, "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "critic_disposition": {"enum": ["PASS", "REJECT", "MORE_EVIDENCE_REQUIRED"]}, "recommendation": {"enum": ["TASK", "KNOWLEDGE", "REJECT", "DEFER"]}, "knowledge_promotion_authority": {"const": false}, "task_allocation_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
