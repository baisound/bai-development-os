{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai-development-os.local/schemas/design-governance/handoff-intake-manifest.schema.json",
  "title": "Handoff Intake Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "project_id", "consumer_id", "supplied_at", "source_artifacts", "claimed_repository", "claimed_ref", "claimed_version", "provenance_complete", "sensitivity", "missing_sources", "assumptions", "canonical_authority", "source_fingerprint", "idempotency_key", "content_checksum"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "handoff-intake-manifest"},
    "intake_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"}, "consumer_id": {"$ref": "#/$defs/id"},
    "supplied_at": {"type": "string", "format": "date-time"},
    "source_artifacts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "source_name", "sha256", "size_bytes", "retention_location"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "source_name": {"type": "string", "minLength": 1, "maxLength": 512}, "sha256": {"$ref": "#/$defs/checksum"}, "size_bytes": {"type": "integer", "minimum": 0}, "retention_location": {"type": ["string", "null"], "maxLength": 2048}}}},
    "claimed_repository": {"type": "string", "minLength": 1, "maxLength": 2048}, "claimed_ref": {"type": "string", "minLength": 1, "maxLength": 512}, "claimed_version": {"type": ["string", "null"], "maxLength": 128},
    "provenance_complete": {"type": "boolean"}, "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "missing_sources": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}, "assumptions": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "canonical_authority": {"const": false}, "source_fingerprint": {"$ref": "#/$defs/checksum"}, "idempotency_key": {"$ref": "#/$defs/checksum"}, "content_checksum": {"$ref": "#/$defs/checksum"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
