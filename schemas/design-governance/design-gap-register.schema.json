{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/design-gap-register.schema.json", "title": "Design Gap Register", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "gap_id", "category", "severity", "confidence", "evidence_refs", "disposition", "required_authority", "canonical_authority", "content_checksum"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_type": {"const": "design-gap-register"}, "intake_id": {"$ref": "#/$defs/id"}, "gap_id": {"$ref": "#/$defs/id"}, "category": {"type": "string", "minLength": 1, "maxLength": 128}, "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/checksum"}}, "disposition": {"enum": ["OPEN", "OWNER_REQUIRED", "DEFERRED", "REJECTED"]}, "required_authority": {"type": "string", "minLength": 1, "maxLength": 512}, "canonical_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
