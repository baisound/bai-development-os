{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/design-completeness-report.schema.json", "title": "Design Completeness Report", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "sections", "critic_refs", "judge_refs", "gate_result", "canonical_authority", "content_checksum"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_type": {"const": "design-completeness-report"}, "intake_id": {"$ref": "#/$defs/id"}, "sections": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["section_id", "status", "justification"], "properties": {"section_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["COMPLETE", "NOT_APPLICABLE", "MISSING"]}, "justification": {"type": ["string", "null"], "maxLength": 2048}}}}, "critic_refs": {"type": "array", "items": {"$ref": "#/$defs/checksum"}}, "judge_refs": {"type": "array", "items": {"$ref": "#/$defs/checksum"}}, "gate_result": {"enum": ["PASS", "FAIL", "STALE", "OWNER_DECISION_REQUIRED"]}, "canonical_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
