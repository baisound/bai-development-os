{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/implementation-coverage-record.schema.json", "title": "Implementation Coverage Record", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "requirement_id", "mappings", "coverage_state", "change_surface", "canonical_authority", "content_checksum"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_type": {"const": "implementation-coverage-record"}, "intake_id": {"$ref": "#/$defs/id"}, "requirement_id": {"$ref": "#/$defs/id"}, "mappings": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["TASK", "SUBSYSTEM", "MODULE", "SCHEMA", "STORE", "TEST", "UI", "ADAPTER"]}, "id": {"type": "string", "minLength": 1, "maxLength": 1024}}}}, "coverage_state": {"enum": ["IMPLEMENTED", "PARTIAL", "MISSING", "NOT_APPLICABLE"]}, "change_surface": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}, "canonical_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
