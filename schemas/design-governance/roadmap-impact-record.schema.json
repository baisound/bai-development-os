{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/roadmap-impact-record.schema.json", "title": "Roadmap Impact Record", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "decision", "dependencies", "insertion_point", "safe_checkpoint", "blocked_tasks", "unaffected_tasks", "migration", "owner_gates", "proposed_source_count_effect", "task_allocation_authority", "canonical_mutation_authority", "content_checksum"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_type": {"const": "roadmap-impact-record"}, "intake_id": {"$ref": "#/$defs/id"}, "decision": {"enum": ["INSERT", "MERGE_EXISTING_TASK", "DEFER", "REJECT", "NO_CHANGE"]}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "insertion_point": {"type": ["string", "null"], "maxLength": 512}, "safe_checkpoint": {"$ref": "#/$defs/checksum"}, "blocked_tasks": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "unaffected_tasks": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "migration": {"enum": ["NONE", "COMPATIBLE", "BREAKING_REQUIRES_PLAN"]}, "owner_gates": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}}, "proposed_source_count_effect": {"type": "integer", "minimum": -1000, "maximum": 1000}, "task_allocation_authority": {"const": false}, "canonical_mutation_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
