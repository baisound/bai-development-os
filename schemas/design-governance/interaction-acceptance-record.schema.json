{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/interaction-acceptance-record.schema.json", "title": "Interaction Acceptance Record", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "environment_identity", "evidence_class", "actual_event_semantics", "layout_dpi", "accessibility", "long_data", "recovery", "evidence_refs", "acceptance_result", "canonical_authority", "content_checksum"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_type": {"const": "interaction-acceptance-record"}, "intake_id": {"$ref": "#/$defs/id"}, "environment_identity": {"type": "string", "minLength": 1, "maxLength": 1024}, "evidence_class": {"enum": ["REAL_NATIVE", "HOSTED_ONLY", "MOCK", "STATIC", "UNKNOWN"]}, "actual_event_semantics": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "PARKED"]}, "layout_dpi": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "PARKED"]}, "accessibility": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "PARKED"]}, "long_data": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "PARKED"]}, "recovery": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "PARKED"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/checksum"}}, "acceptance_result": {"enum": ["PASS", "FAIL", "PARKED"]}, "canonical_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}},
  "allOf": [{"if": {"properties": {"acceptance_result": {"const": "PASS"}}, "required": ["acceptance_result"]}, "then": {"properties": {"evidence_class": {"const": "REAL_NATIVE"}, "actual_event_semantics": {"enum": ["PASS", "NOT_APPLICABLE"]}, "layout_dpi": {"enum": ["PASS", "NOT_APPLICABLE"]}, "accessibility": {"enum": ["PASS", "NOT_APPLICABLE"]}, "long_data": {"enum": ["PASS", "NOT_APPLICABLE"]}, "recovery": {"enum": ["PASS", "NOT_APPLICABLE"]}, "evidence_refs": {"minItems": 1}}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
