{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/source-curation-record.schema.json", "title": "Source Curation Record", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "decisions", "canonical_authority", "content_checksum"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_type": {"const": "source-curation-record"}, "intake_id": {"$ref": "#/$defs/id"}, "decisions": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "ownership", "relevance", "freshness", "superseded_by", "retention", "redaction"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "ownership": {"enum": ["OS", "CONSUMER", "SHARED_REFERENCE", "UNKNOWN"]}, "relevance": {"enum": ["RELEVANT", "SUPPORTING", "OUT_OF_SCOPE", "UNKNOWN"]}, "freshness": {"enum": ["CURRENT", "HISTORICAL", "STALE", "UNKNOWN"]}, "superseded_by": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "retention": {"enum": ["REFERENCE_ONLY", "DERIVED_ONLY", "RETAIN", "REJECT"]}, "redaction": {"enum": ["NONE", "REQUIRED", "COMPLETED", "REJECTED"]}}}}, "canonical_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
