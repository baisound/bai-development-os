{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/regression-surface-record.schema.json", "title": "Regression Surface Record", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "visible_functions", "commands", "state_transitions", "schemas", "ui_adapter_behavior", "tests", "native_evidence_refs", "protected_invariants", "canonical_authority", "content_checksum"],
  "properties": {"schema_version": {"const": "1.0.0"}, "record_type": {"const": "regression-surface-record"}, "intake_id": {"$ref": "#/$defs/id"}, "visible_functions": {"$ref": "#/$defs/strings"}, "commands": {"$ref": "#/$defs/strings"}, "state_transitions": {"$ref": "#/$defs/strings"}, "schemas": {"$ref": "#/$defs/strings"}, "ui_adapter_behavior": {"$ref": "#/$defs/strings"}, "tests": {"$ref": "#/$defs/strings"}, "native_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/checksum"}}, "protected_invariants": {"$ref": "#/$defs/strings"}, "canonical_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "strings": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}}
}
