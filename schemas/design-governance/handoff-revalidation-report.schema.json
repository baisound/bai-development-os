{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://bai-development-os.local/schemas/design-governance/handoff-revalidation-report.schema.json", "title": "Handoff Revalidation Report", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "intake_id", "observation", "canonical_facts", "claim_results", "gate_result", "canonical_authority", "content_checksum"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "record_type": {"const": "handoff-revalidation-report"}, "intake_id": {"$ref": "#/$defs/id"},
    "observation": {"type": "object", "additionalProperties": false, "required": ["os_root", "branch", "head_sha", "dirty", "status_revision"], "properties": {"os_root": {"type": "string", "minLength": 1, "maxLength": 2048}, "branch": {"type": "string", "minLength": 1, "maxLength": 512}, "head_sha": {"$ref": "#/$defs/checksum"}, "dirty": {"type": "boolean"}, "status_revision": {"$ref": "#/$defs/checksum"}}},
    "canonical_facts": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["fact_key", "value", "value_checksum"], "properties": {"fact_key": {"type": "string", "minLength": 1, "maxLength": 512}, "value": {"type": ["string", "number", "boolean", "null"]}, "value_checksum": {"$ref": "#/$defs/checksum"}}}},
    "claim_results": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "fact_key", "severity", "claimed_value", "observed_value", "result", "evidence_refs"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/id"}, "fact_key": {"type": "string", "minLength": 1, "maxLength": 512}, "severity": {"$ref": "#/$defs/severity"},
          "claimed_value": {"type": ["string", "number", "boolean", "null"]}, "observed_value": {"type": ["string", "number", "boolean", "null"]},
          "result": {"enum": ["CONFIRMED_CURRENT", "CONFIRMED_HISTORICAL", "ALREADY_IMPLEMENTED", "PARTIALLY_IMPLEMENTED", "SUPERSEDED", "CONFLICTS_WITH_CURRENT_CANONICAL", "UNVERIFIED", "MISSING_EVIDENCE"]},
          "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/checksum"}}
        }
      }
    },
    "gate_result": {"enum": ["PASS", "FAIL"]}, "canonical_authority": {"const": false}, "content_checksum": {"$ref": "#/$defs/checksum"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]}}
}
