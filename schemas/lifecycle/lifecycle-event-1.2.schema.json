{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "lifecycle-event-1.2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["event_schema_version", "transition_id", "task_id", "expected_revision", "resulting_revision", "from", "to", "outcome", "reason_code", "reason", "requested_by", "authorized_by", "applied_by", "authorization_reference", "evidence", "lease_id", "fencing_token", "created_at", "verified_at", "operation_type", "source_record_schema_version", "resulting_record_schema_version", "source_classification", "resulting_classification", "previous_entry_checksum", "entry_checksum"],
  "properties": {
    "event_schema_version": { "const": "1.2.0" }, "transition_id": { "type": "string", "format": "uuid" }, "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "expected_revision": { "type": ["integer", "null"] }, "resulting_revision": { "type": ["integer", "null"] }, "from": { "oneOf": [{ "$ref": "#/$defs/axes" }, { "type": "null" }] }, "to": { "oneOf": [{ "$ref": "#/$defs/axes" }, { "type": "null" }] },
    "outcome": { "enum": ["COMMITTED", "REJECTED", "VERIFICATION_FAILED", "RECOVERED"] }, "operation_type": { "enum": ["TASK_CLASSIFICATION", "DESIGN_ONLY_CLOSURE", "LEGACY_COMPLETION_ATTEST", "PHASE1", "RECOVERY", "CLOSURE", "ARCHIVE", "LIFECYCLE_RECOVERY"] }, "created_at": { "type": "string", "format": "date-time" },
    "previous_entry_checksum": { "type": "string", "minLength": 1 }, "entry_checksum": { "$ref": "#/$defs/checksum" },
    "resulting_canonical_checksum": { "type": ["string", "null"] }, "record_mutation": { "type": "boolean" },
    "reason_code": { "type": ["string", "null"] }, "reason": { "type": "string" }, "failure_code": { "type": "string" }, "failure_reason": { "type": "string" },
    "requested_by": { "$ref": "#/$defs/actor" }, "authorized_by": { "$ref": "#/$defs/actor" }, "applied_by": { "$ref": "#/$defs/actor" }, "authorization_reference": { "oneOf": [{ "$ref": "#/$defs/authorizationReference" }, { "type": "null" }] }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "lease_id": { "type": ["string", "null"] }, "fencing_token": { "type": ["integer", "null"] }, "verified_at": { "type": ["string", "null"] },
    "audit_id": { "type": "string", "format": "uuid" }, "original_request_id": { "type": ["string", "null"] }, "sanitized_request_digest": { "$ref": "#/$defs/checksum" },
    "source_record_schema_version": { "type": ["string", "null"] }, "resulting_record_schema_version": { "type": ["string", "null"] }, "source_classification": { "type": ["string", "null"] }, "resulting_classification": { "type": ["string", "null"] },
    "operation_bundle": { "$ref": "design-only-operation-bundle.schema.json" },
    "operation_audit": { "$ref": "#/$defs/operationAudit" }, "operation_audit_checksum": { "$ref": "#/$defs/checksum" },
    "design_only_receipt_coordinates": { "type": "object", "additionalProperties": false, "required": ["classification"], "properties": { "classification": { "$ref": "#/$defs/receiptCoordinate" }, "completion": { "$ref": "#/$defs/receiptCoordinate" } } }, "archive_authority": { "$ref": "design-only-archive-authority.schema.json" }, "original_transition_id": { "type": "string", "format": "uuid" }, "recovery_metadata": { "type": "object", "additionalProperties": false, "required": ["recovery_actor", "recovered_stage", "result"], "properties": { "recovery_actor": { "type": "string", "minLength": 1 }, "recovered_stage": { "type": "string", "minLength": 1 }, "result": { "type": "string", "minLength": 1 } } },
    "attested_log_prefix_length": { "type": "integer", "minimum": 0 }, "attested_log_prefix_head_checksum": { "$ref": "#/$defs/checksum" }
  },
  "oneOf": [
    {
      "properties": { "outcome": { "const": "COMMITTED" }, "resulting_revision": { "type": "integer", "minimum": 1 } },
      "not": { "anyOf": [{ "required": ["failure_code"] }, { "required": ["failure_reason"] }, { "required": ["audit_id"] }, { "required": ["sanitized_request_digest"] }, { "required": ["original_transition_id"] }, { "required": ["recovery_metadata"] }] },
      "allOf": [
        { "if": { "properties": { "operation_type": { "enum": ["TASK_CLASSIFICATION", "DESIGN_ONLY_CLOSURE", "LEGACY_COMPLETION_ATTEST"] } } }, "then": { "required": ["operation_bundle", "operation_audit", "operation_audit_checksum", "resulting_canonical_checksum"] }, "else": { "not": { "anyOf": [{ "required": ["operation_bundle"] }, { "required": ["operation_audit"] }, { "required": ["operation_audit_checksum"] }] } } },
        { "if": { "properties": { "operation_type": { "const": "LEGACY_COMPLETION_ATTEST" } } }, "then": { "required": ["attested_log_prefix_length", "attested_log_prefix_head_checksum"] }, "else": { "not": { "anyOf": [{ "required": ["attested_log_prefix_length"] }, { "required": ["attested_log_prefix_head_checksum"] }] } } },
        { "if": { "properties": { "operation_type": { "const": "ARCHIVE" }, "source_classification": { "const": "DESIGN_ONLY" } }, "required": ["operation_type", "source_classification"] }, "then": { "required": ["archive_authority", "design_only_receipt_coordinates"] }, "else": { "not": { "required": ["archive_authority"] } } },
        { "if": { "properties": { "operation_type": { "not": { "enum": ["TASK_CLASSIFICATION", "DESIGN_ONLY_CLOSURE", "LEGACY_COMPLETION_ATTEST"] } }, "source_classification": { "const": "DESIGN_ONLY" } }, "required": ["operation_type", "source_classification"] }, "then": { "required": ["design_only_receipt_coordinates"] }, "else": { "not": { "required": ["design_only_receipt_coordinates"] } } },
        { "if": { "properties": { "operation_type": { "not": { "enum": ["TASK_CLASSIFICATION", "DESIGN_ONLY_CLOSURE", "LEGACY_COMPLETION_ATTEST"] } }, "source_classification": { "const": "DESIGN_ONLY" }, "from": { "properties": { "task_status": { "const": "COMPLETED" } }, "required": ["task_status"] } }, "required": ["operation_type", "source_classification", "from"] }, "then": { "properties": { "design_only_receipt_coordinates": { "required": ["completion"] } } } }
      ]
    },
    {
      "properties": { "outcome": { "const": "REJECTED" }, "resulting_revision": { "type": "null" }, "authorization_reference": { "type": "null" }, "evidence": { "maxItems": 0 }, "lease_id": { "type": "null" }, "fencing_token": { "type": "null" }, "verified_at": { "type": "null" } },
      "required": ["audit_id", "sanitized_request_digest", "failure_code", "failure_reason"],
      "not": { "anyOf": [{ "required": ["operation_bundle"] }, { "required": ["operation_audit"] }, { "required": ["operation_audit_checksum"] }, { "required": ["archive_authority"] }, { "required": ["design_only_receipt_coordinates"] }, { "required": ["attested_log_prefix_length"] }, { "required": ["attested_log_prefix_head_checksum"] }, { "required": ["original_transition_id"] }, { "required": ["recovery_metadata"] }] }
    },
    {
      "properties": { "outcome": { "const": "VERIFICATION_FAILED" }, "resulting_revision": { "type": "null" }, "authorization_reference": { "type": "null" }, "evidence": { "maxItems": 0 }, "lease_id": { "type": "null" }, "fencing_token": { "type": "null" }, "verified_at": { "type": "null" } },
      "required": ["audit_id", "sanitized_request_digest", "failure_code", "failure_reason"],
      "not": { "anyOf": [{ "required": ["operation_bundle"] }, { "required": ["operation_audit"] }, { "required": ["operation_audit_checksum"] }, { "required": ["archive_authority"] }, { "required": ["design_only_receipt_coordinates"] }, { "required": ["attested_log_prefix_length"] }, { "required": ["attested_log_prefix_head_checksum"] }, { "required": ["original_transition_id"] }, { "required": ["recovery_metadata"] }] }
    },
    {
      "properties": { "outcome": { "const": "RECOVERED" }, "resulting_revision": { "type": "null" }, "lease_id": { "type": "null" }, "fencing_token": { "type": "null" } },
      "required": ["original_transition_id", "recovery_metadata"],
      "not": { "anyOf": [{ "required": ["failure_code"] }, { "required": ["failure_reason"] }, { "required": ["audit_id"] }, { "required": ["sanitized_request_digest"] }, { "required": ["operation_bundle"] }, { "required": ["operation_audit"] }, { "required": ["operation_audit_checksum"] }, { "required": ["archive_authority"] }, { "required": ["attested_log_prefix_length"] }, { "required": ["attested_log_prefix_head_checksum"] }] },
      "allOf": [{ "if": { "properties": { "source_classification": { "const": "DESIGN_ONLY" } }, "required": ["source_classification"] }, "then": { "required": ["design_only_receipt_coordinates"] }, "else": { "not": { "required": ["design_only_receipt_coordinates"] } } }]
    }
  ],
  "$defs": {
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "actor": { "type": "object", "additionalProperties": false, "required": ["actor_id", "actor_type", "role_id", "session_id", "run_id"], "properties": { "actor_id": { "type": "string", "minLength": 1 }, "actor_type": { "enum": ["ROLE", "SYSTEM_COMPONENT", "OWNER"] }, "role_id": { "type": ["string", "null"] }, "session_id": { "type": ["string", "null"] }, "run_id": { "type": ["string", "null"] } } },
    "axes": { "type": "object", "additionalProperties": false, "required": ["task_status", "current_phase", "gate_status", "authorization_status", "archive_status"], "properties": { "task_status": { "type": "string" }, "current_phase": { "type": "string" }, "gate_status": { "type": "string" }, "authorization_status": { "type": "string" }, "archive_status": { "type": "string" } } },
    "receiptCoordinate": { "type": "object", "additionalProperties": false, "required": ["transition_id", "event_checksum", "receipt_checksum"], "properties": { "transition_id": { "type": "string", "format": "uuid" }, "event_checksum": { "$ref": "#/$defs/checksum" }, "receipt_checksum": { "$ref": "#/$defs/checksum" } } },
    "authorizationReference": { "type": "object", "additionalProperties": false, "required": ["authorization_id", "authority_type", "authority_path", "authority_checksum", "decision", "effective_at", "expires_at", "scope"], "properties": { "authorization_id": { "type": "string" }, "authority_type": { "enum": ["RULE", "JUDGE", "OWNER"] }, "authority_path": { "type": "string" }, "authority_checksum": { "$ref": "#/$defs/checksum" }, "decision": { "type": "string" }, "effective_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": ["string", "null"], "format": "date-time" }, "authority_envelope_payload_checksum": { "$ref": "#/$defs/checksum" }, "authority_envelope_key_id": { "type": "string" }, "scope": { "type": "object", "additionalProperties": false, "required": ["task_id", "phases", "operations"], "properties": { "task_id": { "type": "string" }, "phases": { "type": "array", "items": { "type": "string" } }, "operations": { "type": "array", "items": { "type": "string" } } } } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["path", "checksum", "authoring_role", "result", "observed_at"], "properties": { "source_id": { "type": "string" }, "path": { "type": "string" }, "checksum": { "$ref": "#/$defs/checksum" }, "authoring_role": { "type": "string" }, "result": { "type": "string" }, "observed_at": { "type": "string", "format": "date-time" } } },
    "operationAudit": { "type": "object", "additionalProperties": false, "required": ["audit_schema_version", "operation", "transition_id", "task_id", "source_revision", "resulting_revision", "source_record_schema_version", "resulting_record_schema_version", "source_classification", "resulting_classification", "from", "to", "skipped_phases", "context_manifest_checksum", "decision_checksum", "operation_coordinate_checksum", "owner_authorization_payload_checksum", "authority_attestation_payload_checksum", "resulting_canonical_checksum", "created_at", "content_checksum"], "properties": { "audit_schema_version": { "const": "1.0.0" }, "operation": { "enum": ["TASK_CLASSIFICATION", "DESIGN_ONLY_CLOSURE", "LEGACY_COMPLETION_ATTEST"] }, "transition_id": { "type": "string", "format": "uuid" }, "task_id": { "type": "string" }, "source_revision": { "type": "integer" }, "resulting_revision": { "type": "integer" }, "source_record_schema_version": { "type": "string" }, "resulting_record_schema_version": { "type": "string" }, "source_classification": { "type": "string" }, "resulting_classification": { "type": "string" }, "from": { "$ref": "#/$defs/axes" }, "to": { "$ref": "#/$defs/axes" }, "skipped_phases": { "type": "array", "items": { "$ref": "#/$defs/skippedPhase" } }, "context_manifest_checksum": { "$ref": "#/$defs/checksum" }, "decision_checksum": { "$ref": "#/$defs/checksum" }, "operation_coordinate_checksum": { "$ref": "#/$defs/checksum" }, "owner_authorization_payload_checksum": { "$ref": "#/$defs/checksum" }, "authority_attestation_payload_checksum": { "$ref": "#/$defs/checksum" }, "resulting_canonical_checksum": { "$ref": "#/$defs/checksum" }, "created_at": { "type": "string", "format": "date-time" }, "content_checksum": { "$ref": "#/$defs/checksum" } }, "allOf": [{ "if": { "properties": { "operation": { "const": "DESIGN_ONLY_CLOSURE" } }, "required": ["operation"] }, "then": { "properties": { "skipped_phases": { "minItems": 6, "maxItems": 6, "prefixItems": [{ "$ref": "#/$defs/skipImplementationAuthorization" }, { "$ref": "#/$defs/skipImplementation" }, { "$ref": "#/$defs/skipTesting" }, { "$ref": "#/$defs/skipImplementationReview" }, { "$ref": "#/$defs/skipFinalJudgment" }, { "$ref": "#/$defs/skipPolicyReview" }] } } }, "else": { "properties": { "skipped_phases": { "maxItems": 0 } } } }] },
    "skippedPhase": { "type": "object", "additionalProperties": false, "required": ["phase", "entered", "gate_result", "authorization"], "properties": { "phase": { "enum": ["IMPLEMENTATION_AUTHORIZATION", "IMPLEMENTATION", "TESTING", "IMPLEMENTATION_REVIEW", "FINAL_JUDGMENT", "POLICY_REVIEW"] }, "entered": { "const": false }, "gate_result": { "const": "NOT_APPLICABLE" }, "authorization": { "const": "NOT_REQUIRED" } } },
    "skipImplementationAuthorization": { "allOf": [{ "$ref": "#/$defs/skippedPhase" }, { "properties": { "phase": { "const": "IMPLEMENTATION_AUTHORIZATION" } } }] },
    "skipImplementation": { "allOf": [{ "$ref": "#/$defs/skippedPhase" }, { "properties": { "phase": { "const": "IMPLEMENTATION" } } }] },
    "skipTesting": { "allOf": [{ "$ref": "#/$defs/skippedPhase" }, { "properties": { "phase": { "const": "TESTING" } } }] },
    "skipImplementationReview": { "allOf": [{ "$ref": "#/$defs/skippedPhase" }, { "properties": { "phase": { "const": "IMPLEMENTATION_REVIEW" } } }] },
    "skipFinalJudgment": { "allOf": [{ "$ref": "#/$defs/skippedPhase" }, { "properties": { "phase": { "const": "FINAL_JUDGMENT" } } }] },
    "skipPolicyReview": { "allOf": [{ "$ref": "#/$defs/skippedPhase" }, { "properties": { "phase": { "const": "POLICY_REVIEW" } } }] }
  }
}
