{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "legacy-completion-attestation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["legacy_completion_statement_version", "project_id", "task_id", "record_revision", "canonical_checksum", "log_prefix_length", "log_prefix_head_checksum", "completion_evidence_checksums", "migration_epoch", "attested_at", "base_context_checksum", "content_checksum"],
  "properties": {
    "legacy_completion_statement_version": { "const": "1.0.0" }, "project_id": { "type": "string", "minLength": 1 }, "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "record_revision": { "type": "integer", "minimum": 1 }, "canonical_checksum": { "$ref": "#/$defs/checksum" }, "log_prefix_length": { "type": "integer", "minimum": 0 }, "log_prefix_head_checksum": { "$ref": "#/$defs/checksum" },
    "completion_evidence_checksums": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/checksum" } }, "migration_epoch": { "type": "integer", "minimum": 1 },
    "attested_at": { "type": "string", "format": "date-time" }, "base_context_checksum": { "$ref": "#/$defs/checksum" }, "content_checksum": { "$ref": "#/$defs/checksum" }
  }, "$defs": { "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
