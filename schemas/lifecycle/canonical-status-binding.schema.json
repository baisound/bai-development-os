{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-status-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_schema_version", "source", "observation_id", "project_id", "task_id", "task_status", "task_classification", "record_revision", "canonical_checksum", "transition_id", "event_checksum", "receipt_checksum", "canonical_authority", "observed_at", "expires_at", "content_checksum", "key_id", "signature_algorithm", "signed_at", "signature", "payload_checksum"],
  "properties": {
    "binding_schema_version": { "const": "1.1.0" },
    "source": { "const": "LIFECYCLE_STORE_VERIFIED_READ" },
    "observation_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "task_status": { "enum": ["DRAFT", "ACTIVE", "PAUSED", "BLOCKED", "STALLED", "COMPLETED", "CANCELLED", "REJECTED", "ARCHIVED"] },
    "task_classification": { "enum": ["DESIGN_ONLY", "IMPLEMENTATION", "UNKNOWN"] },
    "record_revision": { "type": "integer", "minimum": 1 },
    "canonical_checksum": { "$ref": "#/$defs/checksum" },
    "transition_id": { "type": "string", "minLength": 1 },
    "event_checksum": { "oneOf": [{ "$ref": "#/$defs/checksum" }, { "type": "null" }] },
    "receipt_checksum": { "oneOf": [{ "$ref": "#/$defs/checksum" }, { "type": "null" }] },
    "canonical_authority": { "const": false },
    "observed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "content_checksum": { "$ref": "#/$defs/checksum" },
    "key_id": { "type": "string", "minLength": 1 }, "signature_algorithm": { "const": "Ed25519" },
    "signed_at": { "type": "string", "format": "date-time" }, "signature": { "type": "string", "minLength": 1 },
    "payload_checksum": { "$ref": "#/$defs/checksum" }
  },
  "$defs": { "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
