{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-only-operation-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_schema_version", "operation", "base_context", "decision_artifact", "operation_coordinate", "owner_authorization", "authority_attestation", "content_checksum"],
  "properties": {
    "bundle_schema_version": { "const": "1.0.0" },
    "operation": { "enum": ["TASK_CLASSIFICATION", "DESIGN_ONLY_CLOSURE", "LEGACY_COMPLETION_ATTEST"] },
    "base_context": { "$ref": "#/$defs/contextManifest" },
    "decision_artifact": { "oneOf": [{ "$ref": "#/$defs/classificationStatement" }, { "$ref": "design-only-closure-readiness.schema.json" }, { "$ref": "legacy-completion-attestation.schema.json" }] },
    "operation_coordinate": { "$ref": "#/$defs/operationCoordinate" },
    "owner_authorization": { "$ref": "#/$defs/ownerAuthorization" },
    "authority_attestation": { "$ref": "design-only-authority-attestation.schema.json" },
    "content_checksum": { "$ref": "#/$defs/checksum" }
  },
  "$defs": {
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["source_id", "path", "trust_level", "sensitivity", "content_checksum", "token_estimate", "updated_at", "revalidate_after", "priority", "instruction_authority"], "properties": { "source_id": { "type": "string" }, "path": { "type": "string" }, "trust_level": { "enum": ["CANONICAL", "TRUSTED", "REFERENCE", "UNTRUSTED"] }, "sensitivity": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] }, "content_checksum": { "$ref": "#/$defs/checksum" }, "token_estimate": { "type": "integer", "minimum": 0 }, "updated_at": { "type": "string", "format": "date-time" }, "revalidate_after": { "type": ["string", "null"], "format": "date-time" }, "priority": { "type": "integer" }, "instruction_authority": { "type": "boolean" } } },
    "contextManifest": { "type": "object", "additionalProperties": false, "required": ["manifest_schema_version", "manifest_id", "task_id", "status_revision", "role", "phase", "required_sources", "optional_sources", "excluded_sources", "source_priority", "summary_reference", "token_estimate", "duplicate_sources", "stale_optional_sources", "created_at", "content_checksum"], "properties": { "manifest_schema_version": { "const": "1.0.0" }, "manifest_id": { "type": "string", "format": "uuid" }, "task_id": { "type": "string" }, "status_revision": { "type": "integer", "minimum": 1 }, "role": { "type": "string" }, "phase": { "enum": ["FINAL_PLAN", "CLOSURE"] }, "required_sources": { "type": "array", "items": { "$ref": "#/$defs/source" }, "maxItems": 32 }, "optional_sources": { "type": "array", "maxItems": 0 }, "excluded_sources": { "type": "array", "maxItems": 0 }, "source_priority": { "type": "array", "items": { "type": "string" } }, "summary_reference": { "type": ["string", "null"] }, "token_estimate": { "type": "integer", "minimum": 0 }, "duplicate_sources": { "type": "array", "maxItems": 0 }, "stale_optional_sources": { "type": "array", "maxItems": 0 }, "created_at": { "type": "string", "format": "date-time" }, "content_checksum": { "$ref": "#/$defs/checksum" } } },
    "classificationStatement": { "type": "object", "additionalProperties": false, "required": ["statement_schema_version", "task_id", "classification", "implementation_required", "implementation_authorized", "base_context_checksum", "task_definition_checksum", "allowed_files_checksum", "content_checksum"], "properties": { "statement_schema_version": { "const": "1.0.0" }, "task_id": { "type": "string" }, "classification": { "const": "DESIGN_ONLY" }, "implementation_required": { "const": false }, "implementation_authorized": { "const": false }, "base_context_checksum": { "$ref": "#/$defs/checksum" }, "task_definition_checksum": { "$ref": "#/$defs/checksum" }, "allowed_files_checksum": { "$ref": "#/$defs/checksum" }, "content_checksum": { "$ref": "#/$defs/checksum" } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["record_schema_version", "task_status", "current_phase", "gate_status", "authorization_status", "archive_status"], "properties": { "record_schema_version": { "enum": ["1.1.0", "1.2.0"] }, "task_classification": { "const": "DESIGN_ONLY" }, "task_status": { "type": "string" }, "current_phase": { "type": "string" }, "gate_status": { "type": "string" }, "authorization_status": { "type": "string" }, "archive_status": { "type": "string" }, "log_prefix_length": { "type": "integer", "minimum": 0 }, "log_prefix_head_checksum": { "$ref": "#/$defs/checksum" } } },
    "operationCoordinate": { "type": "object", "additionalProperties": false, "required": ["coordinate_schema_version", "preparation_id", "project_id", "task_id", "operation", "phase", "capabilities", "source_revision", "source_canonical_checksum", "base_context_checksum", "decision_checksum", "target", "content_checksum"], "properties": { "coordinate_schema_version": { "const": "1.0.0" }, "preparation_id": { "type": "string", "format": "uuid" }, "project_id": { "type": "string" }, "task_id": { "type": "string" }, "operation": { "enum": ["TASK_CLASSIFICATION", "DESIGN_ONLY_CLOSURE", "LEGACY_COMPLETION_ATTEST"] }, "phase": { "enum": ["FINAL_PLAN", "CLOSURE"] }, "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }, "source_revision": { "type": "integer", "minimum": 1 }, "source_canonical_checksum": { "$ref": "#/$defs/checksum" }, "base_context_checksum": { "$ref": "#/$defs/checksum" }, "decision_checksum": { "$ref": "#/$defs/checksum" }, "target": { "$ref": "#/$defs/target" }, "content_checksum": { "$ref": "#/$defs/checksum" } } },
    "ownerAuthorization": { "type": "object", "additionalProperties": false, "required": ["authorization_envelope_version", "approval_id", "authorized", "task_id", "project_id", "phase", "role", "operation", "operation_coordinate_checksum", "authority_epoch", "revocation_proof_checksum", "authority_path", "authority_checksum", "effective_at", "expires_at", "key_id", "signature_algorithm", "signed_at", "signature", "payload_checksum"], "properties": { "authorization_envelope_version": { "const": "1.0.0" }, "approval_id": { "type": "string" }, "authorized": { "const": true }, "task_id": { "type": "string" }, "project_id": { "type": "string" }, "phase": { "enum": ["FINAL_PLAN", "CLOSURE"] }, "role": { "const": "Owner" }, "operation": { "enum": ["TASK_CLASSIFICATION", "DESIGN_ONLY_CLOSURE", "LEGACY_COMPLETION_ATTEST"] }, "operation_coordinate_checksum": { "$ref": "#/$defs/checksum" }, "authority_epoch": { "type": "integer", "minimum": 1 }, "revocation_proof_checksum": { "$ref": "#/$defs/checksum" }, "authority_path": { "type": "string" }, "authority_checksum": { "$ref": "#/$defs/checksum" }, "effective_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": "string", "format": "date-time" }, "key_id": { "type": "string" }, "signature_algorithm": { "const": "Ed25519" }, "signed_at": { "type": "string", "format": "date-time" }, "signature": { "type": "string" }, "payload_checksum": { "$ref": "#/$defs/checksum" } } }
  }
}
