{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "design-only-critic-evidence.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["critic_evidence_schema_version", "round", "critic_id", "findings", "unresolved_critical", "unresolved_high", "result", "content_checksum"],
  "properties": {
    "critic_evidence_schema_version": { "const": "1.0.0" }, "round": { "enum": [1, 2, 3] }, "critic_id": { "type": "string", "minLength": 1 },
    "findings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["finding_id", "severity", "status"], "properties": { "finding_id": { "type": "string", "minLength": 1 }, "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] }, "status": { "enum": ["OPEN", "RESOLVED"] } } } },
    "unresolved_critical": { "type": "integer", "minimum": 0 }, "unresolved_high": { "type": "integer", "minimum": 0 }, "result": { "enum": ["PASS", "FAIL"] }, "content_checksum": { "$ref": "#/$defs/checksum" }
  }, "$defs": { "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
