{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-status-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_snapshot_schema_version", "snapshot_id", "captured_at", "expires_at", "members", "key_id", "signature_algorithm", "signed_at", "signature", "payload_checksum"],
  "properties": {
    "canonical_snapshot_schema_version": { "const": "1.0.0" },
    "snapshot_id": { "type": "string", "format": "uuid" },
    "captured_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "members": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["project_id", "task_id", "record_revision", "canonical_checksum", "binding_payload_checksum"],
        "properties": {
          "project_id": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
          "record_revision": { "type": "integer", "minimum": 1 },
          "canonical_checksum": { "$ref": "#/$defs/checksum" },
          "binding_payload_checksum": { "$ref": "#/$defs/checksum" }
        }
      }
    },
    "key_id": { "type": "string", "minLength": 1 },
    "signature_algorithm": { "const": "Ed25519" },
    "signed_at": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "minLength": 1 },
    "payload_checksum": { "$ref": "#/$defs/checksum" }
  },
  "$defs": { "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
