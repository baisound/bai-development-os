{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Resume Checkpoint","type":"object","required":["checkpoint_schema_version","checkpoint_id","task_id","status_revision","saved_status","saved_phase","last_completed_action","next_action","required_files","working_tree_state","environment_fingerprint","running_processes","external_dependencies","authorization_snapshot","budget_snapshot","unconfirmed_items","invalidation_triggers","created_at","expires_at","emergency_stop","resume_requires_owner","content_checksum"],"properties":{"checkpoint_schema_version":{"const":"1.0.0"},"checkpoint_id":{"type":"string","minLength":1},"task_id":{"type":"string","pattern":"^TASK-[0-9]{3,}$"},"status_revision":{"type":"integer","minimum":1},"saved_status":{"enum":["ACTIVE","PAUSED","BLOCKED","STALLED"]},"saved_phase":{"type":"string","minLength":1},"content_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"additionalProperties":true}
