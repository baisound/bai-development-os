{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://baisound.dev/schemas/foundation-guard/activation-entry-registry.schema.json",
  "type":"object","additionalProperties":false,
  "required":["revision","entries","checksum"],
  "properties":{
    "revision":{"type":"integer","minimum":1},
    "checksum":{"type":"string","pattern":"^sha256:"},
    "entries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["entry_id","owner","gateway","enabled","roles","scopes"],"properties":{
      "entry_id":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1},"gateway":{"const":"CONTEXT_GUARD_GATEWAY"},"enabled":{"type":"boolean"},
      "roles":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"scopes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
    }}}
  }
}
