{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.dev/schemas/integration/integration-request.schema.json",
  "title": "BAI Integration Request",
  "type": "object",
  "required": [
    "integration_request_version",
    "request_id",
    "project_id",
    "connector_id",
    "capability",
    "operation",
    "payload",
    "data_classification",
    "estimated_cost_microusd",
    "content_checksum"
  ],
  "properties": {
    "integration_request_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "payload": {},
    "data_classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ]
    },
    "credential_ref": {
      "type": [
        "object",
        "null"
      ]
    },
    "estimated_cost_microusd": {
      "type": "integer",
      "minimum": 0
    },
    "license_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "content_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
