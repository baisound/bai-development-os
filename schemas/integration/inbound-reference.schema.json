{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.dev/schemas/integration/inbound-reference.schema.json",
  "title": "BAI Inbound Integration Reference",
  "type": "object",
  "required": [
    "inbound_reference_version",
    "reference_id",
    "provider",
    "event_type",
    "project_id",
    "received_at",
    "trust",
    "canonical",
    "payload",
    "requires_review_for_canonicalization"
  ],
  "properties": {
    "inbound_reference_version": {
      "const": "1.0.0"
    },
    "reference_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "trust": {
      "const": "UNTRUSTED"
    },
    "canonical": {
      "const": false
    },
    "payload": {},
    "requires_review_for_canonicalization": {
      "const": true
    }
  },
  "additionalProperties": false
}
