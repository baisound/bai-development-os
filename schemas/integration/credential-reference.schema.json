{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.dev/schemas/integration/credential-reference.schema.json",
  "title": "BAI Credential Reference",
  "type": "object",
  "required": [
    "credential_ref",
    "provider",
    "scopes"
  ],
  "properties": {
    "credential_ref": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
