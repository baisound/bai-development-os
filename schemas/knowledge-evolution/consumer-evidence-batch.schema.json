{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.example/schemas/knowledge-evolution/consumer-evidence-batch.schema.json",
  "title": "BAI Canonical Consumer Evidence Batch Ver.1.0",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "created_at",
    "product",
    "installation",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "product": {
      "type": "object",
      "required": [
        "product_id",
        "product_version"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "product_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "required": [
        "installation_id"
      ],
      "properties": {
        "installation_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "consumer-evidence-event.schema.json"
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "description": "The only v1 logical runtime Evidence Batch for Hub and Object Storage transport. content_sha256 hashes canonical JSON with that field omitted."
}
