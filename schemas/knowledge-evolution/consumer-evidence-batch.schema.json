{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.example/schemas/knowledge-evolution/consumer-evidence-batch.schema.json",
  "title": "BAI Consumer Evidence Batch Planning Contract",
  "type": "object",
  "required": [
    "schema_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "consumer-evidence-envelope.schema.json"
      }
    }
  },
  "additionalProperties": false
}
