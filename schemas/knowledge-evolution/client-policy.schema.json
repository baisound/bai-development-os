{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.example/schemas/knowledge-evolution/client-policy.schema.json",
  "title": "BAI Consumer Evidence Client Policy Ver.1.0",
  "type": "object",
  "required": [
    "policy_version",
    "accepted_schema_versions",
    "event_catalog_version",
    "max_batch_events",
    "max_payload_bytes",
    "max_outbox_bytes",
    "max_privacy_level"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "accepted_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "event_catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "sampling": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "enabled_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "max_batch_events": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_payload_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    },
    "max_outbox_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_privacy_level": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    }
  },
  "additionalProperties": false
}
