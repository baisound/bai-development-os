{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.local/schemas/knowledge/knowledge-candidate.schema.json",
  "title": "BAI Knowledge Candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "source_evidence_ids",
    "status",
    "scope",
    "risk",
    "title",
    "statement",
    "required_review"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 8
    },
    "source_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "CANDIDATE",
        "SUPPORTED",
        "CONFLICTED",
        "REJECTED",
        "PROMOTED",
        "SUPERSEDED",
        "DEPRECATED"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "project",
        "domain",
        "product-family",
        "organization",
        "universal"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_review": {
      "type": "string",
      "enum": [
        "LIGHTWEIGHT",
        "CRITIC",
        "CRITIC_AND_JUDGE"
      ]
    }
  },
  "additionalProperties": false
}
