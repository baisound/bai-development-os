{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.dev/schemas/conformance/portability-report.schema.json",
  "title": "BAI Development OS Portability Coverage Report",
  "type": "object",
  "required": [
    "status",
    "targets"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "CONDITIONAL",
        "FAIL"
      ]
    },
    "targets": {
      "type": "array"
    },
    "limitation": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
