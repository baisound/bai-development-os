{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bai.dev/schemas/conformance/isolation-report.schema.json",
  "title": "BAI Development OS Isolation Report",
  "type": "object",
  "required": [
    "status",
    "violations"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "CONDITIONAL",
        "FAIL",
        "NOT_APPLICABLE"
      ]
    },
    "checked_pairs": {
      "type": "integer",
      "minimum": 0
    },
    "checked": {
      "type": [
        "integer",
        "array"
      ]
    },
    "violations": {
      "type": "array"
    }
  }
}
