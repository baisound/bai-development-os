{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.local/schemas/distributed/distributed-broker-state.schema.json",
  "title": "Distributed Broker State",
  "type": "object",
  "required": [
    "distributed_broker_state_version",
    "revision",
    "events",
    "effects",
    "operations",
    "content_checksum"
  ],
  "properties": {
    "distributed_broker_state_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array"
    },
    "effects": {
      "type": "array"
    },
    "operations": {
      "type": "array"
    },
    "content_checksum": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
