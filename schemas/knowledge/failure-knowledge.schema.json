{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://baisound.local/schemas/knowledge/failure-knowledge.schema.json",
  "title":"Failure Knowledge Extension",
  "type":"object",
  "additionalProperties":false,
  "required":["fingerprint","failure_mode","environment_scope","safe_action","prohibited_inference","evidence_refs"],
  "properties":{
    "fingerprint":{"type":"string","minLength":1},
    "failure_mode":{"type":"string","minLength":1},
    "environment_scope":{"type":"array","items":{"type":"string"}},
    "safe_action":{"type":"string","minLength":1},
    "prohibited_inference":{"type":"array","items":{"type":"string"}},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "recurrence_key":{"type":"string"}
  }
}
