{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baisound.local/schemas/knowledge/knowledge-asset.schema.json",
  "title": "BAI Development OS Knowledge Asset",
  "type": "object",
  "additionalProperties": true,
  "required": ["asset_id","revision","title","knowledge_type","status","maturity","enforcement","scope","source_trust","sensitivity","confidence","provenance","content","freshness","created_at","updated_at","checksum"],
  "properties": {
    "asset_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "revision": {"type":"integer","minimum":1},
    "title": {"type":"string","minLength":1},
    "knowledge_type": {"enum":["PRINCIPLE","GOOD_PRACTICE","PROHIBITION","SUCCESS_CASE","FAILURE_CASE","LESSON_LEARNED","ADR","PROCEDURE","TEMPLATE","QUALITY_CRITERION","TROUBLESHOOTING"]},
    "status": {"enum":["CANDIDATE","DRAFT","UNDER_REVIEW","ACTIVE","STALE","DEPRECATED","INVALID","ARCHIVED"]},
    "maturity": {"enum":["EXPERIENCE","OBSERVATION","IDEA","KNOWLEDGE_ASSET","FRAMEWORK","STANDARD","ORGANIZATION_STANDARD"]},
    "enforcement": {"enum":["MANDATORY","CONDITIONAL_MANDATORY","ADVISORY","REFERENCE"]},
    "scope": {"$ref":"#/$defs/scope"},
    "source_trust": {"enum":["CANONICAL","OFFICIAL","VERIFIED_INTERNAL","USER_OBSERVED","EXTERNAL_REFERENCE","AI_INFERRED","UNTRUSTED"]},
    "sensitivity": {"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED"]},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "tags": {"type":"array","items":{"type":"string"}},
    "taxonomy_node_ids": {"type":"array","items":{"type":"string"}},
    "relations": {"type":"array","items":{"$ref":"#/$defs/relation"}},
    "provenance": {"$ref":"#/$defs/provenance"},
    "content": {"$ref":"#/$defs/content"},
    "freshness": {"$ref":"#/$defs/freshness"},
    "created_at": {"type":"string","format":"date-time"},
    "updated_at": {"type":"string","format":"date-time"},
    "checksum": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "scope": {
      "type":"object","required":["level"],"additionalProperties":true,
      "properties":{"level":{"enum":["GLOBAL","DOMAIN","TECHNOLOGY","SPECIALIZATION","TOOL","PROJECT","TASK"]},"domain":{"type":"string"},"technology":{"type":"string"},"specialization":{"type":"string"},"tool":{"type":"string"},"project_id":{"type":"string"},"task_id":{"type":"string"}}
    },
    "relation": {"type":"object","required":["type","target_asset_id"],"properties":{"type":{"enum":["REQUIRES","EXCEPTION","CONFLICT","SUPERSEDES","DERIVED_FROM","RELATED_TO"]},"target_asset_id":{"type":"string"},"reason":{"type":"string"}}},
    "provenance": {"type":"object","required":["source_ids","evidence_refs","created_by"],"properties":{"source_ids":{"type":"array","items":{"type":"string"}},"evidence_refs":{"type":"array","items":{"type":"string"}},"created_by":{"type":"string","minLength":1}}},
    "content": {"type":"object","required":["summary","guidance","required_actions","prohibited_actions","verification_steps"],"properties":{"summary":{"type":"string","minLength":1},"guidance":{"type":"array","items":{"type":"string"}},"required_actions":{"type":"array","items":{"type":"string"}},"prohibited_actions":{"type":"array","items":{"type":"string"}},"verification_steps":{"type":"array","items":{"type":"string"}}}},
    "freshness": {"type":"object","required":["review_after"],"properties":{"review_after":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"}}}
  }
}
