{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://baisound.dev/schemas/monitoring/monitoring-snapshot.schema.json",
  "type":"object",
  "required":["monitoring_snapshot_version","project_id","generated_at","health","metrics","alerts","source_revisions","source_provenance","canonical_authority","derived_rebuildable","content_checksum"],
  "properties":{
    "monitoring_snapshot_version":{"const":"1.0.0"},"project_id":{"type":"string","minLength":1},"task_id":{"type":["string","null"]},"generated_at":{"type":"string","format":"date-time"},
    "health":{"enum":["HEALTHY","DEGRADED","AT_RISK","CRITICAL"]},"metrics":{"type":"object"},"alerts":{"type":"array"},"source_revisions":{"type":"object"},"source_provenance":{"type":"object"},
    "canonical_authority":{"const":false},"derived_rebuildable":{"const":true},"previous_alert_count":{"type":"integer","minimum":0},"content_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}
  },"additionalProperties":false
}
