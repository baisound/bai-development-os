# Host-only example. Prefer scripts/prepare-compose-env.sh and chmod 600.
# Do not commit real values.
#
# Profile is intentionally NOT defaulted here. Choose one complete tuple:
#   2gb -> postgresql.tuned-2gb.conf / 256mb / pool 5
#   4gb -> postgresql.tuned-4gb.conf / 512mb / pool 10
#   8gb -> postgresql.tuned-8gb.conf / 1gb / pool 10
POSTGRES_IMAGE=postgres:16.14-alpine
POSTGRES_DB=bai_knowledge_hub
POSTGRES_USER=bai_hub
POSTGRES_PASSWORD=REPLACE_AT_DEPLOYMENT
BAI_KNOWLEDGE_HUB_RUNTIME_DB_USER=bai_hub_runtime
BAI_KNOWLEDGE_HUB_RUNTIME_DB_PASSWORD=REPLACE_AT_DEPLOYMENT
POSTGRES_CONFIG_FILE=REPLACE_WITH_PROFILE_CONFIG
POSTGRES_SHM_SIZE=REPLACE_WITH_PROFILE_SHM
HUB_DOMAIN=hub.example.invalid
BAI_KNOWLEDGE_HUB_RETENTION_DAYS=30
BAI_KNOWLEDGE_HUB_RATE_LIMIT_PER_MINUTE=120
BAI_KNOWLEDGE_HUB_BODY_LIMIT_BYTES=262144
BAI_KNOWLEDGE_HUB_DB_POOL_MAX=REPLACE_WITH_PROFILE_POOL
