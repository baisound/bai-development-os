# Install as /run/bai-development-os/knowledge-hub/rehearsal-recovery.env
# with owner root:root and mode 0600. Replace every CHANGE-ME token.
RECOVERY_JOURNAL_FILE=/var/lib/bai-development-os/knowledge-hub/rehearsals/CHANGE-ME/recovery-journal.jsonl
RECOVERY_AUTHORIZATION_FILE=/run/bai-development-os/knowledge-hub/CHANGE-ME-recovery-authorization.json
BAI_RECOVERY_PSQL_BIN=/usr/lib/postgresql/CHANGE-ME/bin/psql
PGHOST=/run/postgresql
PGPORT=5432
PGADMINUSER=bai_hub
PGDATABASE=knowledge_hub
PGPASSFILE=/run/bai-development-os/knowledge-hub/CHANGE-ME-recovery.pgpass
