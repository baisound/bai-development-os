[Unit]
Description=BAI Knowledge Hub bounded source backup
After=postgresql.service
ConditionPathIsReadWrite=/var/lib/bai-development-os/knowledge-hub/backups

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/run/bai-development-os/knowledge-hub/source-backup.env
UnsetEnvironment=BASH_ENV ENV NODE_OPTIONS NODE_PATH LD_PRELOAD LD_LIBRARY_PATH PGOPTIONS PGSERVICE PGSERVICEFILE PGPASSWORD
ExecStartPre=/usr/bin/node /opt/bai-development-os/deploy/knowledge-hub/systemd/validate-rehearsal-execution-environment.mjs source --require-loaded /run/bai-development-os/knowledge-hub/source-backup.env
ExecStart=/usr/bin/flock --shared /etc/bai-development-os/knowledge-hub/rehearsal-authority.lock /bin/sh /opt/bai-development-os/deploy/knowledge-hub/scripts/backup-postgres.sh
TimeoutStartSec=24h
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
ProtectProc=invisible
RemoveIPC=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/bai-development-os/knowledge-hub/backups /var/lib/bai-development-os/knowledge-hub/source-authority-consumption /run/bai-development-os/knowledge-hub/plaintext

[Install]
WantedBy=multi-user.target
