# Install as /run/bai-development-os/knowledge-hub/source-backup.env
# with owner root:root and mode 0600. Replace every CHANGE-ME token.
PGHOST=/run/postgresql
PGPORT=5432
PGDATABASE=knowledge_hub
PGUSER=bai_hub_backup
PGPASSFILE=/run/bai-development-os/knowledge-hub/CHANGE-ME-source.pgpass
BACKUP_DIR=/var/lib/bai-development-os/knowledge-hub/backups
BAI_CODE_REVISION=CHANGE-ME
BAI_NODE_BIN=/usr/bin/node
BAI_PG_DUMP_BIN=/usr/lib/postgresql/CHANGE-ME/bin/pg_dump
BAI_PG_RESTORE_BIN=/usr/lib/postgresql/CHANGE-ME/bin/pg_restore
BAI_AGE_BIN=/usr/bin/age
BAI_BACKUP_PLAINTEXT_TMPFS_ROOT=/run/bai-development-os/knowledge-hub/plaintext
AGE_RECIPIENT=CHANGE-ME
BACKUP_SOURCE_AUTHORIZATION_FILE=/run/bai-development-os/knowledge-hub/CHANGE-ME-source-authorization.json
SOURCE_AUTHORIZATION_CONSUMPTION_DIR=/var/lib/bai-development-os/knowledge-hub/source-authority-consumption
