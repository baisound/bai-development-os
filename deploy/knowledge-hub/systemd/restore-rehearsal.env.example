# Install as /run/bai-development-os/knowledge-hub/restore-rehearsal.env
# with owner root:root and mode 0600. Replace every CHANGE-ME token.
BAI_BACKUP_RESTORE_ACK=BACKUP_RESTORE_REHEARSAL_ONLY
BACKUP_FILE=/var/lib/bai-development-os/knowledge-hub/backups/CHANGE-ME/knowledge-hub.dump.age
BACKUP_SHA256_FILE=/var/lib/bai-development-os/knowledge-hub/backups/CHANGE-ME/knowledge-hub.dump.age.sha256
BACKUP_MANIFEST_FILE=/var/lib/bai-development-os/knowledge-hub/backups/CHANGE-ME/knowledge-hub.dump.age.manifest.json
BACKUP_SOURCE_COMMIT_FILE=/var/lib/bai-development-os/knowledge-hub/backups/CHANGE-ME/COMMITTED.json
AGE_RECIPIENT=CHANGE-ME
AGE_IDENTITY_FILE=/run/bai-development-os/knowledge-hub/CHANGE-ME-age-identity.txt
REHEARSAL_TARGET_AUTHORIZATION_FILE=/run/bai-development-os/knowledge-hub/CHANGE-ME-target-authorization.json
AUTHORIZATION_CONSUMPTION_DIR=/var/lib/bai-development-os/knowledge-hub/authority-consumption
PLAINTEXT_TMPFS_ROOT=/run/bai-development-os/knowledge-hub/plaintext
BACKUP_RESTORE_ROOT=/var/lib/bai-development-os/knowledge-hub/rehearsals
BACKUP_RESTORE_RUN_DIR=/var/lib/bai-development-os/knowledge-hub/rehearsals/CHANGE-ME
RUN_ID=CHANGE-ME
CODE_REVISION=CHANGE-ME
RESTORE_TARGET_DATABASE=CHANGE-ME_restore_rehearsal
PGHOST=/run/postgresql
PGADMINUSER=bai_hub
PGRESTOREUSER=bai_hub_restore
PGRESTOREEXECUTOR=bai_hub_restore_executor
PGDATABASE=knowledge_hub
PGPORT=5432
PGPASSFILE=/run/bai-development-os/knowledge-hub/CHANGE-ME-restore.pgpass
PGRESTOREPASSFILE=/run/bai-development-os/knowledge-hub/CHANGE-ME-restore-executor.pgpass
